{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@daloa/types": ["../types/src/index.ts"],
      "@daloa/config": ["../config/src/index.ts"],
      "@daloa/utils": ["../utils/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
